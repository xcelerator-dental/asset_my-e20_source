    gap: 10px;
    align-items: center;
    font-size: var(--fs-body);
    color: var(--fg-body);
}

.benefits-row li svg {
    width: 18px;
    height: 18px;
    color: var(--e20-gold);
    flex: 0 0 auto;
}

/* nervous patients */
.nervous {
    background: var(--e20-cream);
