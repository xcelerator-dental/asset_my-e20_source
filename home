.announce a:hover {
    color: #fff;
}

@media (max-width: 700px) {
    .announce .hide-sm {
        display: none;
    }
}

/* ============================================================
   HERO (navy, punchy)
   ============================================================ */
.home-hero {
    position: relative;
    background: var(--e20-navy);
    color: #fff;
    overflow: hidden;
}

.home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 85% 0%, rgba(176,140,90,0.22), transparent 55%);
    pointer-events: none;
}

/* faint chevron motif, brand signature */
.home-hero::after {
    content: "";
    position: absolute;
    right: -4%;
    top: 50%;
    transform: translateY(-50%);
    width: 520px;
    height: 520px;
    opacity: 0.06;
    pointer-events: none;
    background: conic-gradient(from 45deg at 50% 50%, transparent 0 25%, #fff 25% 26%, transparent 26% 50%, transparent 50% 75%, #fff 75% 76%, transparent 76%);
    clip-path: polygon(0 0, 55% 50%, 0 100%, 40% 100%, 95% 50%, 40% 0);
}

.hero-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(48px, 7vw, 104px) 0;
}

.home-hero .eyebrow {
    color: var(--e20-gold-light);
}

.home-hero h1 {
    color: #fff;
    font-size: var(--fs-display-xl);
    font-weight: var(--fw-light);
    line-height: 1.0;
    margin-bottom: 26px;
    letter-spacing: -0.02em;
}

.home-hero h1 .em {
    font-style: italic;
    color: var(--e20-gold-light);
}

.hero-lead {
    font-size: var(--fs-body-lg);
    color: rgba(255,255,255,0.82);
    max-width: 560px;
    margin-bottom: 32px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 36px;
}

.btn--gold-lg {
    padding: 16px 16px 16px 30px;
    font-size: var(--fs-body);
}

.btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.35);
    padding: 16px 30px;
}

.btn--ghost:hover {
    background: rgba(255,255,255,0.1);
    border-color: #fff;
}

.hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-body-sm);
    color: rgba(255,255,255,0.9);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--r-pill);
    padding: 8px 16px;
}

.hero-chip svg {
    width: 14px;
    height: 14px;
    color: var(--e20-gold-light);
}

/* hero capabilities strip (replaces pill chips) */
.hero-disciplines {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 28px;
    max-width: 600px;
}

.hero-disc {
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.28);
}

.hero-disc .d-name {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: #fff;
    letter-spacing: 0.01em;
    line-height: 1.1;
}

.hero-disc .d-sub {
    font-size: 10px;
    color: var(--e20-gold-light);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-top: 8px;
}

@media (max-width: 640px) {
    .hero-disciplines {
        grid-template-columns: 1fr 1fr;
        gap: 20px 24px;
    }
}

.hero-figure {
    position: relative;
}

.hero-figure .frame {
    border-radius: var(--r-2xl);
    overflow: hidden;
    box-shadow: var(--sh-lg);
    aspect-ratio: 5/4;
}

.hero-figure .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-badge {
    position: absolute;
    left: -22px;
    bottom: -22px;
    background: #fff;
    color: var(--e20-navy);
    border-radius: var(--r-xl);
    padding: 20px 24px;
    box-shadow: var(--sh-lg);
    max-width: 230px;
}

.hero-badge .num {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: 40px;
    color: var(--e20-navy);
    line-height: 1;
}

.hero-badge .lbl {
    font-size: var(--fs-body-sm);
    color: var(--fg-secondary);
    margin-top: 6px;
}

@media (max-width: 900px) {
    .hero-wrap {
        grid-template-columns: 1fr;
        gap: 48px;
    }

    .hero-figure .frame {
        aspect-ratio: 16/10;
    }

    .hero-badge {
        left: 16px;
        bottom: -18px;
    }
}

/* bottom credibility bar of hero */
.hero-strip {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--border-on-dark);
}

.hero-strip-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
}

.hero-strip span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-body-sm);
    color: rgba(255,255,255,0.85);
}

.hero-strip svg {
    width: 18px;
    height: 18px;
    color: var(--e20-gold-light);
}

