@media (max-width: 520px) {
    .spec-grid {
        grid-template-columns: 1fr;
    }
}

.spec-grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (max-width: 860px) {
    .spec-grid.three {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 520px) {
    .spec-grid.three {
        grid-template-columns: 1fr;
    }
}

