}

.feature-points {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.feature-points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: rgba(255,255,255,0.88);
}

.feature-points li svg {
    width: 18px;
    height: 18px;
    color: var(--e20-gold-light);
    margin-top: 4px;
    flex: 0 0 auto;
}

.feature-points strong {
