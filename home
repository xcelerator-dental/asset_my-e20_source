    align-items: center;
    gap: 10px;
}

.plan-point .seq b {
    color: #fff;
    font-weight: var(--fw-medium);
}

.plan-point p {
    color: rgba(255,255,255,0.82);
    font-size: var(--fs-body-sm);
}

@media (max-width: 760px) {
    .plan-points {
        grid-template-columns: 1fr;
    }
}

/* svc-card with optional learn-more on cream handled already; add link arrow color on cream */
.svc-card .lm {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    color: var(--e20-navy);
}

.svc-card .lm svg {
    width: 16px;
    height: 16px;
    color: var(--e20-gold);
    transition: transform var(--dur-fast);
}

.svc-card:hover .lm svg {
    transform: translateX(4px);
}

/* before / after example pairs */
.ba-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
