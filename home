    margin-top: 2px;
}

.fee-foot p {
    font-size: var(--fs-body-sm);
    color: var(--fg-secondary);
}

.fee-note {
    margin-top: 24px;
    font-size: var(--fs-body-sm);
    color: var(--fg-secondary);
}

@media (max-width: 520px) {
    .fee-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
}

/* ============================================================
   GUM DISEASE PROGRESSION (shared)
   ============================================================ */
.stages {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: stretch;
}

.stage {
    background: #fff;
    border: 1px solid var(--border-warm);
    border-radius: var(--r-xl);
    padding: 34px 32px;
}

.stage.severe {
    border-color: var(--e20-gold);
}

.stage .s-step {
    font-size: 11px;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--e20-gold);
    font-weight: var(--fw-semibold);
    margin-bottom: 12px;
}

.stage h3 {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-h3);
    letter-spacing: 0;
    margin-bottom: 12px;
}

.stage p {
    color: var(--fg-secondary);
    font-size: var(--fs-body);
}

.stage-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--e20-gold-light);
}

.stage-arrow svg {
    width: 32px;
    height: 32px;
}

.stages-note {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--e20-cream);
    border-left: 3px solid var(--e20-gold);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 20px 24px;
}

.stages-note svg {
    width: 20px;
    height: 20px;
    color: var(--e20-gold-deep);
    flex: 0 0 auto;
    margin-top: 2px;
}

.stages-note p {
    font-size: var(--fs-body-sm);
    color: var(--e20-navy);
}

@media (max-width: 860px) {
    .stages {
        grid-template-columns: 1fr;
