}

@media (max-width: 760px) {
    .ba-grid {
        grid-template-columns: 1fr;
    }
}

/* ============================================================
   FEE TABLE (shared - emergency, hygiene, treatment pages)
   ============================================================ */
.fees {
    background: #fff;
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--sh-card);
}

.fee-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 30px;
    background: var(--e20-navy);
    color: #fff;
}

.fee-head span {
    font-size: 11px;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    font-weight: var(--fw-semibold);
    color: var(--e20-gold-light);
}

.fee-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 30px;
}

.fee-row + .fee-row {
    border-top: 1px solid var(--border-default);
}

.fee-row .f-name {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    color: var(--e20-navy);
    line-height: var(--lh-snug);
}

.fee-row .f-sub {
    font-size: var(--fs-body-sm);
    color: var(--fg-muted);
    margin-top: 5px;
    max-width: 34ch;
}

.fee-row .f-price {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--fs-h3);
    color: var(--e20-navy);
    white-space: nowrap;
    flex: 0 0 auto;
    letter-spacing: -0.01em;
}

.fee-row .f-price.quote {
    font-size: var(--fs-body);
    color: var(--fg-secondary);
    font-weight: var(--fw-regular);
}

.fee-foot {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 20px 30px;
    background: var(--e20-cream);
    border-top: 1px solid var(--border-warm);
}

.fee-foot svg {
    width: 17px;
    height: 17px;
    color: var(--e20-gold);
