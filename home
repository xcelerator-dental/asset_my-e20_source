    text-align: center;
}

.announce strong {
    font-weight: var(--fw-semibold);
}

.announce .pill {
    background: var(--e20-gold);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 3px 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    font-size: var(--fs-caption);
    white-space: nowrap;
}

.announce a {
